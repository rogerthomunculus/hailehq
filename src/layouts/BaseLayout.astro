---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  themeColor?: string;
}

const { title, description = 'Family site.', themeColor = '#16191d' } = Astro.props;
const { pathname } = Astro.url;

const navLinks = [
  { href: '/travel/', label: 'Travel' },
  { href: '/school/', label: 'School' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="site-nav">
      <div class="wrap">
        <a class="brand" href="/">hailehq</a>
        <div class="links">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
    <slot />
  </body>
</html>
