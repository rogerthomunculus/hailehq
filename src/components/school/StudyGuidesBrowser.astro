---
// Live-lists the hailehq-files R2 bucket, grouped by grade folder and (if
// present) a subject subfolder — e.g. "5th Grade/ELA/some-guide.pdf" groups
// under "5th Grade" > "ELA". Drop a PDF into the bucket via the Cloudflare
// dashboard, name the folders however reads naturally (e.g. "5th Grade"),
// and it shows up here on next page load, no redeploy. See
// workers/files-list/README.md for more on the convention.
interface Props {
  prefix?: string;
}

const { prefix = '' } = Astro.props;
const apiBase =
  import.meta.env.PUBLIC_FILES_API_URL || 'https://hailehq-files-list.files-list.workers.dev';
---

<div data-study-guides data-prefix={prefix} data-api={apiBase}>
  <p class="where">Loading study guides…</p>
</div>

<script>
  interface RemoteFile {
    name: string;
    url: string;
  }

  const GENERAL_LABEL = 'General';

  function gradeRank(label: string): number {
    if (label === GENERAL_LABEL) return Infinity;
    const l = label.trim().toLowerCase();
    if (l === 'k' || l.startsWith('kindergarten')) return -1;
    const m = l.match(/\d+/);
    return m ? parseInt(m[0], 10) : 500;
  }

  function fileKind(name: string): string {
    return (name.split('.').pop() || '').toUpperCase();
  }

  function buildFileItem(file: RemoteFile, label: string): HTMLLIElement {
    const li = document.createElement('li');
    const b = document.createElement('b');
    const a = document.createElement('a');
    a.href = file.url;
    a.setAttribute('download', '');
    a.textContent = label;
    b.appendChild(a);

    const span = document.createElement('span');
    span.className = 'where';
    span.textContent = fileKind(label);

    li.append(b, span);
    return li;
  }

  // Groups files by top-level folder (grade) then, if present, a second
  // folder level (subject). Files with no folder at all land in "General".
  function groupFiles(files: RemoteFile[]) {
    const grades = new Map<string, Map<string | null, RemoteFile[]>>();

    for (const file of files) {
      const parts = file.name.split('/');
      const grade = parts.length === 1 ? GENERAL_LABEL : parts[0];
      const subject = parts.length > 2 ? parts[1] : null;
      const label = parts.length === 1 ? parts[0] : parts.slice(subject ? 2 : 1).join('/');

      if (!grades.has(grade)) grades.set(grade, new Map());
      const subjects = grades.get(grade)!;
      if (!subjects.has(subject)) subjects.set(subject, []);
      subjects.get(subject)!.push({ ...file, name: label });
    }

    return grades;
  }

  function render(el: HTMLElement, files: RemoteFile[]) {
    el.replaceChildren();

    if (files.length === 0) {
      const p = document.createElement('p');
      p.className = 'where';
      p.textContent = 'No study guides yet — check back soon.';
      el.appendChild(p);
      return;
    }

    const grades = groupFiles(files);
    const gradeLabels = [...grades.keys()].sort(
      (a, b) => gradeRank(a) - gradeRank(b) || a.localeCompare(b),
    );

    for (const gradeLabel of gradeLabels) {
      const gradeSection = document.createElement('div');
      gradeSection.className = 'grade-group';

      const h3 = document.createElement('h3');
      h3.textContent = gradeLabel;
      gradeSection.appendChild(h3);

      const subjects = grades.get(gradeLabel)!;
      const subjectLabels = [...subjects.keys()].sort((a, b) => {
        if (a === null) return -1;
        if (b === null) return 1;
        return a.localeCompare(b);
      });

      for (const subjectLabel of subjectLabels) {
        const subjectSection = document.createElement('div');
        subjectSection.className = 'subject-group';

        if (subjectLabel !== null) {
          const h4 = document.createElement('h4');
          h4.textContent = subjectLabel;
          subjectSection.appendChild(h4);
        }

        const ul = document.createElement('ul');
        ul.className = 'places';
        const items = subjects.get(subjectLabel)!.sort((a, b) => a.name.localeCompare(b.name));
        for (const file of items) {
          ul.appendChild(buildFileItem(file, file.name));
        }
        subjectSection.appendChild(ul);
        gradeSection.appendChild(subjectSection);
      }

      el.appendChild(gradeSection);
    }
  }

  function renderError(el: HTMLElement) {
    el.replaceChildren();
    const p = document.createElement('p');
    p.className = 'where';
    p.textContent = "Couldn't load study guides right now.";
    el.appendChild(p);
  }

  async function hydrate(el: HTMLElement) {
    const prefix = el.dataset.prefix ?? '';
    const api = el.dataset.api ?? '';

    try {
      const res = await fetch(`${api}/list?prefix=${encodeURIComponent(prefix)}`);
      if (!res.ok) throw new Error(`status ${res.status}`);
      const data = await res.json();
      render(el, Array.isArray(data.files) ? data.files : []);
    } catch {
      renderError(el);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-study-guides]').forEach(hydrate);
</script>

<style>
  :global(.grade-group) {
    margin-top: 2rem;
  }
  :global(.grade-group:first-child) {
    margin-top: 0;
  }
  :global(.grade-group > h3) {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--gold);
    margin: 0 0 0.6rem;
  }
  :global(.subject-group) {
    margin-top: 1rem;
  }
  :global(.subject-group:first-child) {
    margin-top: 0.4rem;
  }
  :global(.subject-group > h4) {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.4rem;
  }
</style>
