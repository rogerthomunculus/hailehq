---
// Placeholder destination illustration in the same hand-built-SVG style as the
// landing page hero art. Swap for real artwork per trip when it exists.
interface Props {
  variant:
    | 'hawaii'
    | 'nyc'
    | 'dallas'
    | 'japan'
    | 'montreal'
    | 'losangeles'
    | 'sandiego'
    | 'chicago'
    | 'floridapanhandle'
    | 'atlanta';
  alt: string;
  caption?: string;
}

const { variant, alt, caption } = Astro.props;

const palette = {
  hawaii: { top: '#0f3a4d', mid: '#146b73', bottom: '#1f8f7a', sun: '#ffd166' },
  nyc: { top: '#0d1526', mid: '#1b2444', bottom: '#2c2f52', sun: '#f2d8e5' },
  dallas: { top: '#2a1a10', mid: '#6b3f1e', bottom: '#c97b3d', sun: '#f2c94c' },
  japan: { top: '#1a1f3d', mid: '#33284d', bottom: '#a94f5b', sun: '#f2d8e5' },
  montreal: { top: '#0f1a2e', mid: '#2a3a5c', bottom: '#5a6f8f', sun: '#d8e4f0' },
  losangeles: { top: '#3a1a4a', mid: '#a83a5c', bottom: '#f2914f', sun: '#ffd166' },
  sandiego: { top: '#0d3b4f', mid: '#1a7a8a', bottom: '#4fc3c9', sun: '#fff2c9' },
  chicago: { top: '#1a2438', mid: '#3a4a6b', bottom: '#7a8ba3', sun: '#f2c94c' },
  floridapanhandle: { top: '#0a4d5c', mid: '#1f9e8f', bottom: '#7fd9c4', sun: '#ffe8a3' },
  atlanta: { top: '#2a1f3d', mid: '#7a4a5c', bottom: '#e8935a', sun: '#ffb26b' },
}[variant];
---

<section class="illustration">
  <svg viewBox="0 0 760 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={alt}>
    <defs>
      <linearGradient id={`sky-${variant}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color={palette.top}></stop>
        <stop offset="55%" stop-color={palette.mid}></stop>
        <stop offset="100%" stop-color={palette.bottom}></stop>
      </linearGradient>
    </defs>
    <rect width="760" height="360" fill={`url(#sky-${variant})`}></rect>
    <circle cx="600" cy="70" r="34" fill={palette.sun} opacity="0.85"></circle>

    {
      variant === 'hawaii' && (
        <g opacity="0.9">
          <path
            d="M0,250 Q190,230 380,255 T760,240 L760,360 L0,360 Z"
            fill="#e8eef2"
            opacity="0.85"
          />
          <path
            d="M0,275 Q190,255 380,278 T760,262"
            stroke="#ffffff"
            stroke-width="4"
            fill="none"
            opacity="0.6"
          />
          <g transform="translate(120,190)">
            <path d="M0,70 C-4,40 -2,10 0,0 C2,10 4,40 0,70 Z" fill="#3a5f3a" />
            <path d="M0,4 C-30,-6 -50,-2 -58,10 C-38,10 -16,10 0,10 Z" fill="#4f8a4f" />
            <path d="M0,4 C28,-8 50,-2 60,12 C38,12 16,10 0,10 Z" fill="#4f8a4f" />
            <path d="M0,4 C-24,10 -40,26 -42,40 C-22,28 -8,16 0,8 Z" fill="#3f7a3f" />
            <path d="M0,4 C22,12 36,28 40,42 C20,28 8,16 0,8 Z" fill="#3f7a3f" />
          </g>
          <g transform="translate(660,205)">
            <path d="M0,55 C-3,32 -1,8 0,0 C1,8 3,32 0,55 Z" fill="#3a5f3a" />
            <path d="M0,3 C-22,-5 -38,-1 -44,8 C-28,8 -12,8 0,8 Z" fill="#4f8a4f" />
            <path d="M0,3 C20,-6 36,-1 42,9 C26,9 12,8 0,8 Z" fill="#4f8a4f" />
          </g>
        </g>
      )
    }

    {
      variant === 'nyc' && (
        <g opacity="0.92">
          <rect x="60" y="150" width="34" height="150" fill="#141b30" />
          <rect x="104" y="110" width="46" height="190" fill="#181f38" />
          <rect x="160" y="170" width="30" height="130" fill="#141b30" />
          <rect x="440" y="130" width="40" height="170" fill="#181f38" />
          <rect x="488" y="90" width="52" height="210" fill="#1e2540" />
          <path d="M488,90 L514,58 L540,90 Z" fill="#1e2540" />
          <rect x="548" y="160" width="34" height="140" fill="#141b30" />
          <rect x="600" y="120" width="44" height="180" fill="#181f38" />
          {Array.from({ length: 26 }).map((_, i) => (
            <rect
              x={64 + (i % 6) * 6}
              y={160 + Math.floor(i / 6) * 22}
              width="3"
              height="5"
              fill="#f2d8e5"
              opacity="0.5"
            />
          ))}
        </g>
      )
    }

    {
      variant === 'dallas' && (
        <g opacity="0.92">
          <rect x="120" y="200" width="30" height="100" fill="#3a2010" />
          <rect x="170" y="160" width="26" height="140" fill="#2e1a0c" />
          <rect x="470" y="150" width="34" height="150" fill="#2e1a0c" />
          <circle cx="487" cy="128" r="20" fill="none" stroke="#f2c94c" stroke-width="4" />
          <line x1="487" y1="150" x2="487" y2="108" stroke="#f2c94c" stroke-width="4" />
          <rect x="520" y="190" width="24" height="110" fill="#3a2010" />
          <rect x="560" y="170" width="28" height="130" fill="#2e1a0c" />
          <path
            d="M0,300 Q190,282 380,298 T760,286 L760,360 L0,360 Z"
            fill="#8a5a2e"
            opacity="0.7"
          />
        </g>
      )
    }

    {
      variant === 'japan' && (
        <g opacity="0.95">
          <path d="M180,260 L340,90 L500,260 Z" fill="#5a4a66" />
          <path d="M255,150 L340,90 L425,150 L400,175 L280,175 Z" fill="#e8eef2" opacity="0.9" />
          <g transform="translate(590,240)">
            <rect x="-8" y="-70" width="10" height="70" fill="#a94f4f" />
            <rect x="38" y="-70" width="10" height="70" fill="#a94f4f" />
            <rect x="-16" y="-78" width="72" height="12" fill="#a94f4f" />
            <rect x="-10" y="-58" width="60" height="9" fill="#a94f4f" />
          </g>
        </g>
      )
    }

    {
      variant === 'montreal' && (
        <g opacity="0.95">
          <path d="M210,270 L340,110 L470,270 Z" fill="#3a4a6b" />
          <g transform="translate(340,90)">
            <line x1="0" y1="0" x2="0" y2="26" stroke="#d8e4f0" stroke-width="4" />
            <line x1="-11" y1="9" x2="11" y2="9" stroke="#d8e4f0" stroke-width="4" />
          </g>
          <rect x="130" y="220" width="26" height="80" fill="#141b2c" />
          <rect x="520" y="200" width="30" height="100" fill="#141b2c" />
          <rect x="560" y="230" width="24" height="70" fill="#1c2740" />
        </g>
      )
    }

    {
      variant === 'losangeles' && (
        <g opacity="0.95">
          <path
            d="M0,240 Q190,190 380,235 T760,220 L760,360 L0,360 Z"
            fill="#5c2a4a"
            opacity="0.7"
          />
          <g transform="translate(150,220)">
            <path d="M0,80 C-4,45 -2,10 0,0 C2,10 4,45 0,80 Z" fill="#3a2540" />
            <path d="M0,4 C-30,-8 -50,-2 -58,10 C-38,10 -16,10 0,10 Z" fill="#6b3a5c" />
            <path d="M0,4 C28,-10 50,-2 60,12 C38,12 16,10 0,10 Z" fill="#6b3a5c" />
          </g>
          <g transform="translate(620,235)">
            <path d="M0,65 C-3,36 -1,8 0,0 C1,8 3,36 0,65 Z" fill="#3a2540" />
            <path d="M0,3 C-22,-6 -38,-1 -44,9 C-28,9 -12,9 0,9 Z" fill="#6b3a5c" />
            <path d="M0,3 C20,-7 36,-1 42,10 C26,10 12,9 0,9 Z" fill="#6b3a5c" />
          </g>
        </g>
      )
    }

    {
      variant === 'sandiego' && (
        <g opacity="0.95">
          <path
            d="M0,255 Q190,235 380,258 T760,242 L760,360 L0,360 Z"
            fill="#e8eef2"
            opacity="0.8"
          />
          <path
            d="M0,278 Q190,258 380,280 T760,264"
            stroke="#ffffff"
            stroke-width="4"
            fill="none"
            opacity="0.6"
          />
          <g transform="translate(140,205)">
            <path d="M0,65 C-3,36 -1,8 0,0 C1,8 3,36 0,65 Z" fill="#1f5c4a" />
            <path d="M0,3 C-22,-6 -38,-1 -44,9 C-28,9 -12,9 0,9 Z" fill="#2e8a6f" />
            <path d="M0,3 C20,-7 36,-1 42,10 C26,10 12,9 0,9 Z" fill="#2e8a6f" />
          </g>
          <g transform="translate(600,230)">
            <path d="M-9,4 L9,4 L6,8 L-6,8 Z" fill="#fff" />
            <line x1="0" y1="4" x2="0" y2="-14" stroke="#fff" stroke-width="1.8" />
            <path d="M0,-13 L11,4 L0,4 Z" fill="#fff" />
          </g>
        </g>
      )
    }

    {
      variant === 'chicago' && (
        <g opacity="0.92">
          <rect x="90" y="210" width="30" height="90" fill="#1c2740" />
          <rect x="140" y="180" width="26" height="120" fill="#141b2c" />
          <rect x="470" y="140" width="42" height="160" fill="#141b2c" />
          <line x1="491" y1="140" x2="491" y2="112" stroke="#141b2c" stroke-width="5" />
          <line x1="481" y1="140" x2="481" y2="120" stroke="#141b2c" stroke-width="4" />
          <line x1="501" y1="140" x2="501" y2="120" stroke="#141b2c" stroke-width="4" />
          <rect x="530" y="200" width="28" height="100" fill="#1c2740" />
          <ellipse cx="330" cy="292" rx="26" ry="13" fill="#7a8ba3" opacity="0.85" />
          <path
            d="M0,320 Q190,308 380,322 T760,314 L760,360 L0,360 Z"
            fill="#3a4a6b"
            opacity="0.6"
          />
        </g>
      )
    }

    {
      variant === 'floridapanhandle' && (
        <g opacity="0.95">
          <path
            d="M0,250 Q190,225 380,252 T760,235 L760,360 L0,360 Z"
            fill="#f2ede0"
            opacity="0.9"
          />
          <path
            d="M0,272 Q190,250 380,275 T760,258"
            stroke="#ffffff"
            stroke-width="4"
            fill="none"
            opacity="0.6"
          />
          <g transform="translate(560,210)">
            <path d="M0,-55 L-32,-30 L32,-30 Z" fill="#a94f4f" />
            <path d="M0,-55 L0,-30" stroke="#8a3f3f" stroke-width="2" />
            <line x1="0" y1="-30" x2="0" y2="30" stroke="#7a5a3a" stroke-width="4" />
          </g>
        </g>
      )
    }

    {
      variant === 'atlanta' && (
        <g opacity="0.92">
          <rect x="120" y="220" width="28" height="80" fill="#2e2038" />
          <rect x="165" y="190" width="24" height="110" fill="#241a2e" />
          <rect x="480" y="150" width="34" height="150" fill="#241a2e" />
          <path d="M497,150 L497,118" stroke="#241a2e" stroke-width="5" />
          <path d="M489,118 L505,118 L497,102 Z" fill="#241a2e" />
          <rect x="530" y="210" width="26" height="90" fill="#2e2038" />
          <g transform="translate(230,265)">
            <ellipse cx="0" cy="0" rx="34" ry="24" fill="#3a5c3a" opacity="0.8" />
            <rect x="-4" y="18" width="8" height="20" fill="#4a3a2a" />
          </g>
          <g transform="translate(610,270)">
            <ellipse cx="0" cy="0" rx="28" ry="20" fill="#3a5c3a" opacity="0.8" />
            <rect x="-3" y="15" width="6" height="18" fill="#4a3a2a" />
          </g>
        </g>
      )
    }

    <path
      d="M0,300 L140,235 L260,285 L400,220 L540,290 L680,250 L760,270 L760,360 L0,360 Z"
      fill="#181225"
      opacity="0.55"></path>
    <ellipse cx="380" cy="345" rx="380" ry="26" fill="#0d0810" opacity="0.4"></ellipse>

    <g transform="translate(300,282)">
      <ellipse cx="0" cy="52" rx="70" ry="8" fill="#000" opacity="0.25"></ellipse>
      <circle cx="-36" cy="6" r="11" fill="#F2C9A0"></circle>
      <rect x="-46" y="15" width="20" height="30" rx="7" fill="#ff6fa8"></rect>
      <rect x="-52" y="18" width="10" height="18" rx="4" fill="#6B7FD9"></rect>
      <circle cx="-10" cy="2" r="12" fill="#F2C9A0"></circle>
      <rect x="-21" y="12" width="22" height="34" rx="7" fill="#3EC8A8"></rect>
      <rect x="-27" y="15" width="11" height="20" rx="4" fill="#2E9C82"></rect>
      <circle cx="18" cy="10" r="9" fill="#F2C9A0"></circle>
      <rect x="10" y="18" width="16" height="24" rx="6" fill="#7fabe8"></rect>
      <circle cx="42" cy="12" r="8" fill="#F2C9A0"></circle>
      <rect x="35" y="19" width="14" height="22" rx="6" fill="#8B7FD9"></rect>
    </g>
  </svg>
  {caption && <p class="caption">{caption}</p>}
</section>

<style>
  .illustration {
    margin: calc(var(--sp) * 1.6) 0;
    border: 1px solid var(--rule);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
  }
  .illustration svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .caption {
    margin: 0;
    padding: 12px var(--sp);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    border-top: 1px solid var(--rule);
  }
</style>
