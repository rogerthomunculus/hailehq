---
interface Props {
  id: string;
  num: string;
  title: string;
  subtitle?: string;
}

const { id, num, title, subtitle } = Astro.props;
---

<section id={id}>
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-num">{num}</span>
      <h2>{title}</h2>
      {subtitle && <p class="sec-sub">{subtitle}</p>}
    </div>
    <slot />
  </div>
</section>
