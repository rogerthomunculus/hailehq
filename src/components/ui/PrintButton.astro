---
interface Props {
  label?: string;
}

const { label = 'Save as PDF' } = Astro.props;
---

<button type="button" class="print-btn" onclick="window.print()">
  <svg
    viewBox="0 0 24 24"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M6 9V3h12v6"></path>
    <path d="M6 18H4a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2"></path>
    <rect x="6" y="14" width="12" height="7"></rect>
  </svg>
  {label}
</button>

<style>
  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted, #888);
    background: transparent;
    border: 1px solid var(--rule, #444);
    border-radius: 8px;
    padding: 8px 14px;
    cursor: pointer;
    transition: 0.15s;
  }
  .print-btn:hover {
    color: var(--text, #fff);
    border-color: var(--gold, #b08540);
  }
  @media print {
    .print-btn {
      display: none;
    }
  }
</style>
