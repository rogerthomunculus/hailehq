---
import { getCollection } from 'astro:content';

const { pathname } = Astro.url;

const allTravelGuides = (await getCollection('travel', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
// A guide with a `planningGroup` (a trip still being planned, delivered as a
// bundle of coordinated docs — a guide plus a budget comparison, say) moves
// out of the flat Travel list into its own "Travel Planning" > <group> nest
// instead, so a multi-doc trip-in-progress doesn't clutter the trip-log list.
const travelGuides = allTravelGuides.filter((g) => !g.data.planningGroup);
const planningGuides = allTravelGuides.filter((g) => g.data.planningGroup);

// Houston isn't MDX prose (see src/content/houston/), so it isn't in the `travel`
// collection — it gets its own static route but belongs in the same nav group.
const travelLinks = [
  ...travelGuides.map((g) => ({ href: `/travel/${g.id}/`, label: g.data.destination })),
  { href: '/travel/houston-2026/', label: 'Houston' },
].sort((a, b) => a.label.localeCompare(b.label));

// Grouped in document order (already sorted by `order` above), not
// alphabetically — a plan reads top-to-bottom like the trip guide itself.
const planningGroups = new Map<string, { href: string; label: string }[]>();
for (const g of planningGuides) {
  const group = g.data.planningGroup!;
  const links = planningGroups.get(group) ?? [];
  links.push({ href: `/travel/${g.id}/`, label: g.data.destination });
  planningGroups.set(group, links);
}

// The last two are their own Vercel projects on their own subdomains, not
// routes in this repo, so they're absolute links marked as leaving the site.
const schoolLinks = [
  { href: '/school/blookets/', label: 'Blookets' },
  { href: '/school/study-guides/', label: 'Study Guides' },
  { href: '/school/spelling/', label: 'Spelling' },
  { href: 'https://practice.hailehq.com/', label: 'Practice Tests', external: true },
  { href: 'https://write.hailehq.com/', label: 'Writing Coach', external: true },
];
---

<button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
  ☰
</button>

<aside class="sidebar" id="sidebar">
  <a class="brand" href="/">
    Hai Le <span>HQ</span>
  </a>
  <nav>
    <a class="nav-link" href="/" aria-current={pathname === '/' ? 'page' : undefined}>
      Home
    </a>

    <button class="nav-group-toggle" id="travelToggle" aria-expanded="true">
      Travel
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </button>
    <div class="nav-group open" id="travelGroup">
      {travelLinks.map((l) => (
        <a href={l.href} aria-current={pathname.startsWith(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </div>

    {planningGroups.size > 0 && (
      <>
        <button class="nav-group-toggle" id="travelPlanningToggle" aria-expanded="true">
          Travel Planning
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
        <div class="nav-group open" id="travelPlanningGroup">
          {[...planningGroups].map(([group, links]) => (
            <div class="nav-subgroup">
              <span class="nav-subgroup-label">{group}</span>
              <div class="nav-subgroup-links">
                {links.map((l) => (
                  <a href={l.href} aria-current={pathname.startsWith(l.href) ? 'page' : undefined}>
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </>
    )}

    <button class="nav-group-toggle" id="schoolToggle" aria-expanded="true">
      School
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </button>
    <div class="nav-group open" id="schoolGroup">
      {schoolLinks.map((l) => (
        <a
          href={l.href}
          aria-current={!l.external && pathname.startsWith(l.href) ? 'page' : undefined}
        >
          {l.label}
          {l.external && (
            <span class="ext" aria-hidden="true">
              ↗
            </span>
          )}
        </a>
      ))}
    </div>
  </nav>
  <div class="sidebar-foot">hailehq.com</div>
</aside>

<script>
  // The CSS max-height-transition trick needs a target height. A hardcoded
  // one clips silently once a group's content grows past it (Travel just
  // did, at 12 destinations) — measuring the real content height instead
  // means it never needs bumping again as more content is added.
  function wireToggle(toggleId: string, groupId: string) {
    const toggle = document.getElementById(toggleId);
    const group = document.getElementById(groupId);
    if (!toggle || !group) return;
    if (toggle.getAttribute('aria-expanded') === 'true') {
      group.style.maxHeight = `${group.scrollHeight}px`;
    }
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      group.classList.toggle('open', !open);
      group.style.maxHeight = open ? '0px' : `${group.scrollHeight}px`;
    });
  }
  wireToggle('travelToggle', 'travelGroup');
  wireToggle('travelPlanningToggle', 'travelPlanningGroup');
  wireToggle('schoolToggle', 'schoolGroup');

  document.getElementById('menuToggle')?.addEventListener('click', () => {
    document.getElementById('sidebar')?.classList.toggle('open');
  });
</script>
