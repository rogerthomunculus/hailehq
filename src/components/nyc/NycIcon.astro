---
// NYC Trip Guide — icon set.
//
// Same idea as src/components/japan/japan-icons.tsx, but authored as an Astro
// component rather than React so it renders server-side and can be dropped
// straight into MDX (and into VenueList) with no client island.
//
// Every icon is a 24x24 stroke drawing using currentColor, so it inherits
// colour from whatever wraps it. Colours come from tokens.css via the parent —
// nothing here hardcodes a hex value.
//
// Usage:
//   <NycIcon name="subway" />
//   <NycIcon name="pizza" size={18} />

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

