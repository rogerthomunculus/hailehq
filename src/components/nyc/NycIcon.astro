const path = ICONS[name] ?? ICONS.subway;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class:list={['nyc-icon', className]}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={path}
/>

<style>
  .nyc-icon {
    display: block;
    flex: 0 0 auto;
  }
</style>
