---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hai Le HQ"
  description="A running log of the trips we plan, book, and actually take."
>
  <div class="wrap">
    <header class="landing-hero">
      <p class="eyebrow">Hai Le HQ · Family Travel Log</p>
      <h1 class="landing-h1">Where we've<br />been stamped</h1>
      <p class="standfirst">
        A running log of the trips we plan, book, and actually take — kept somewhere more permanent
        than a group chat.
      </p>
      <div class="stamps">
        <a class="stamp" href="/travel/iceland-2026/">Iceland<br />Jul 2026</a>
        <a class="stamp" href="/travel/houston-2026/">Houston<br />Sep 2026</a>
        <a class="stamp soon" href="/travel/hawaii-2025/">Hawaii<br />Jul 2025</a>
        <a class="stamp soon" href="/travel/nyc-2025/">NYC<br />Jun 2025</a>
        <a class="stamp soon" href="/travel/dallas-2025/">Dallas<br />Apr 2025</a>
        <a class="stamp" href="/travel/japan-2024/">Japan<br />Jul 2024</a>
      </div>
    </header>

    <section class="illustration">
      <svg
        viewBox="0 0 760 360"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Illustrated placeholder of a family looking at the northern lights in Iceland"
      >
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1a1f3d"></stop>
            <stop offset="55%" stop-color="#2a2350"></stop>
            <stop offset="100%" stop-color="#3d2a4a"></stop>
          </linearGradient>
          <linearGradient id="auroraA" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#3EC8A8" stop-opacity="0"></stop>
            <stop offset="50%" stop-color="#3EC8A8" stop-opacity=".55"></stop>
            <stop offset="100%" stop-color="#9FE0EC" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="auroraB" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#8B7FD9" stop-opacity="0"></stop>
            <stop offset="50%" stop-color="#C9A2E0" stop-opacity=".45"></stop>
            <stop offset="100%" stop-color="#8B7FD9" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <rect width="760" height="360" fill="url(#sky)"></rect>
        <path d="M0,80 Q190,20 380,90 T760,60" stroke="url(#auroraA)" stroke-width="34" fill="none"
        ></path>
        <path
          d="M0,130 Q200,70 400,140 T760,110"
          stroke="url(#auroraB)"
          stroke-width="26"
          fill="none"></path>
        <circle cx="120" cy="60" r="1.6" fill="#f2d8e5" opacity=".8"></circle>
        <circle cx="600" cy="45" r="1.6" fill="#f2d8e5" opacity=".7"></circle>
        <circle cx="670" cy="90" r="1.2" fill="#f2d8e5" opacity=".6"></circle>
        <circle cx="260" cy="35" r="1.2" fill="#f2d8e5" opacity=".6"></circle>
        <circle cx="450" cy="70" r="1.4" fill="#f2d8e5" opacity=".7"></circle>
        <path
          d="M0,260 L110,175 L200,240 L300,150 L410,255 L520,190 L630,250 L760,210 L760,360 L0,360 Z"
          fill="#100d18"
          opacity=".9"></path>
        <path
          d="M0,300 L140,235 L260,285 L400,220 L540,290 L680,250 L760,270 L760,360 L0,360 Z"
          fill="#181225"></path>
        <ellipse cx="380" cy="345" rx="380" ry="26" fill="#E8EEF2" opacity=".9"></ellipse>
        <g transform="translate(300,282)">
          <ellipse cx="0" cy="52" rx="70" ry="8" fill="#000" opacity=".25"></ellipse>
          <circle cx="-36" cy="6" r="11" fill="#F2C9A0"></circle>
          <rect x="-46" y="15" width="20" height="30" rx="7" fill="#ff6fa8"></rect>
          <rect x="-52" y="18" width="10" height="18" rx="4" fill="#6B7FD9"></rect>
          <circle cx="-10" cy="2" r="12" fill="#F2C9A0"></circle>
          <rect x="-21" y="12" width="22" height="34" rx="7" fill="#3EC8A8"></rect>
          <rect x="-27" y="15" width="11" height="20" rx="4" fill="#2E9C82"></rect>
          <circle cx="18" cy="10" r="9" fill="#F2C9A0"></circle>
          <rect x="10" y="18" width="16" height="24" rx="6" fill="#7fabe8"></rect>
          <circle cx="42" cy="12" r="8" fill="#F2C9A0"></circle>
          <rect x="35" y="19" width="14" height="22" rx="6" fill="#8B7FD9"></rect>
        </g>
        <g transform="translate(560,300)" opacity=".92">
          <rect x="-46" y="-14" width="92" height="34" rx="9" fill="#b888a0"></rect>
          <rect x="-38" y="-24" width="52" height="18" rx="8" fill="#b888a0"></rect>
          <circle cx="-26" cy="22" r="10" fill="#24171e"></circle>
          <circle cx="26" cy="22" r="10" fill="#24171e"></circle>
          <rect x="-30" y="-8" width="18" height="12" rx="2" fill="#2a2350" opacity=".6"></rect>
        </g>
      </svg>
      <p class="caption">Placeholder illustration — swap in your own artwork here.</p>
    </section>

    <section class="destinations">
      <h2 class="landing-h2">Guides</h2>
      <div class="cards">
        <a class="landing-card" href="/travel/houston-2026/">
          <span class="card-eyebrow">Sept 2026</span>
          <h3>Houston</h3>
          <p>Group experiences with the cousins, ranked and categorized.</p>
        </a>
        <a class="landing-card" href="/travel/iceland-2026/">
          <span class="card-eyebrow">Jul 2026</span>
          <h3>Iceland</h3>
          <p>The full 12-day trip guide — bookings, gear, what went wrong.</p>
        </a>
        <a class="landing-card is-soon" href="/travel/hawaii-2025/">
          <span class="soon-badge">Coming Soon</span>
          <span class="card-eyebrow">Jul 2025</span>
          <h3>Hawaii</h3>
          <p>Write-up coming once we're back and the photos are sorted.</p>
        </a>
        <a class="landing-card is-soon" href="/travel/nyc-2025/">
          <span class="soon-badge">Coming Soon</span>
          <span class="card-eyebrow">Jun 2025</span>
          <h3>NYC</h3>
          <p>Write-up coming once we're back and the photos are sorted.</p>
        </a>
        <a class="landing-card is-soon" href="/travel/dallas-2025/">
          <span class="soon-badge">Coming Soon</span>
          <span class="card-eyebrow">Apr 2025</span>
          <h3>Dallas</h3>
          <p>Write-up coming once we're back and the photos are sorted.</p>
        </a>
        <a class="landing-card" href="/travel/japan-2024/">
          <span class="card-eyebrow">Jul 2024</span>
          <h3>Japan</h3>
          <p>The full one-month, five-base-camp trip guide — bookings, gear, what we'd skip.</p>
        </a>
      </div>
    </section>

    <section class="destinations">
      <h2 class="landing-h2">School</h2>
      <div class="cards">
        <a class="landing-card" href="/school/blookets/">
          <span class="card-eyebrow">Study Sets</span>
          <h3>Blookets</h3>
          <p>Every Blooket set, grouped by grade and subject.</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .landing-hero {
    padding: calc(var(--sp) * 1.8) 0 var(--sp);
  }
  .landing-h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(42px, 9vw, 72px);
    line-height: 0.94;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .standfirst {
    color: var(--muted);
    max-width: 48ch;
    margin: 0 0 26px;
    font-size: 16px;
  }
  .stamps {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .stamp {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 2px dashed var(--stamp);
    color: var(--stamp);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.4;
    transform: rotate(-6deg);
    flex: 0 0 auto;
    text-decoration: none;
  }
  .stamp:nth-child(even) {
    transform: rotate(4deg);
  }
  .stamp:hover {
    border-style: solid;
    color: var(--text);
    background: var(--surface2);
  }
  .stamp.soon {
    opacity: 0.5;
    border-style: dotted;
  }
  .stamp.soon:hover {
    opacity: 0.85;
  }
  .illustration {
    margin: calc(var(--sp) * 1.6) 0;
    border: 1px solid var(--rule);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
  }
  .illustration svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .caption {
    margin: 0;
    padding: 12px var(--sp);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    border-top: 1px solid var(--rule);
  }
  .destinations {
    padding-bottom: calc(var(--sp) * 2);
    border-bottom: none;
  }
  .landing-h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: 26px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 0 0 16px;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 560px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .landing-card {
    display: block;
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 20px;
    background: var(--surface);
    transition: 0.15s;
    text-decoration: none;
  }
  .landing-card:hover {
    border-color: var(--gold);
    color: inherit;
  }
  .landing-card {
    position: relative;
  }
  .landing-card.is-soon {
    border-style: dashed;
  }
  .landing-card.is-soon:hover {
    border-color: var(--rule);
  }
  .soon-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 3px 7px;
  }
  .card-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 8px;
  }
  .landing-card h3 {
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .landing-card p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
</style>
