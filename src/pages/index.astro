---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hai Le HQ"
  description="Travel guides and school study guides from our family, with more of what we're into on the way."
>
  <div class="wrap">
    <header class="landing-hero">
      <p class="eyebrow">Hai Le HQ · Family Site</p>
      <h1 class="landing-h1">Where we've<br />been stamped</h1>
      <p class="standfirst">
        Travel guides and school study guides, mostly — kept somewhere more permanent than a group
        chat. Plus whatever else we're into; more on that below.
      </p>
      <div class="stamps">
        <a class="stamp" href="/travel/iceland-2026/">Iceland<br />Jul 2026</a>
        <a class="stamp" href="/travel/houston-2026/">Houston<br />Sep 2026</a>
        <a class="stamp" href="/travel/hawaii-2025/">Hawaii<br />Jun 2025</a>
        <a class="stamp" href="/travel/nyc-2025/">NYC<br />2023–25</a>
        <a class="stamp" href="/travel/dallas-2025/">Dallas<br />Apr 2025</a>
        <a class="stamp" href="/travel/japan-2024/">Japan<br />Jul 2024</a>
      </div>
    </header>

    <section class="illustration">
      <svg
        viewBox="0 0 760 360"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Illustration of the four of us surrounded by icons for travel, boats, school, fishing, kaiju and anime, outdoors, arcades, aquatics, 3D printing, crafts, and toys"
      >
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#2e1a24"></stop>
            <stop offset="55%" stop-color="#8a4a68"></stop>
            <stop offset="100%" stop-color="#eab568"></stop>
          </linearGradient>
        </defs>
        <rect width="760" height="360" fill="url(#sky)"></rect>

        <!-- confetti -->
        <circle cx="60" cy="40" r="3" fill="#ff6fa8" opacity=".6"></circle>
        <circle cx="700" cy="130" r="2.5" fill="#7fabe8" opacity=".6"></circle>
        <circle cx="380" cy="30" r="2" fill="#f2c94c" opacity=".7"></circle>
        <circle cx="250" cy="220" r="2" fill="#3EC8A8" opacity=".5"></circle>
        <circle cx="720" cy="230" r="2.5" fill="#f2d8e5" opacity=".5"></circle>

        <ellipse cx="380" cy="345" rx="380" ry="26" fill="#f2d8e5" opacity=".12"></ellipse>

        <!-- interest badges -->
        <g transform="translate(90,108)">
          <circle r="27" fill="#ff6fa8"></circle>
          <path d="M7.5,-7.5 L2.25,7.5 L-0.75,0.75 L-7.5,-2.25 Z" fill="#fff"></path>
          <line
            x1="7.5"
            y1="-7.5"
            x2="-0.75"
            y2="0.75"
            stroke="#ff6fa8"
            stroke-width="1.3"
            opacity=".9"></line>
        </g>
        <g transform="translate(30,170)">
          <circle r="20" fill="#3EC8A8"></circle>
          <path d="M-9,4 L9,4 L6,8 L-6,8 Z" fill="#fff"></path>
          <line x1="0" y1="4" x2="0" y2="-9" stroke="#fff" stroke-width="1.8"></line>
          <path d="M0,-8 L7,3 L0,3 Z" fill="#fff"></path>
        </g>
        <g transform="translate(210,62)">
          <circle r="25" fill="#7fabe8"></circle>
          <path d="M-11,-7 L-1,-9 L-1,7 L-11,9 Z" fill="#fff"></path>
          <path d="M11,-7 L1,-9 L1,7 L11,9 Z" fill="#fff"></path>
        </g>
        <g transform="translate(380,35)">
          <circle r="20" fill="#f2c94c"></circle>
          <path d="M-9,6 L-9,-1 L-5,-7 L-2,-1 L2,-8 L5,-1 L9,-6 L9,6 Z" fill="#fff"></path>
          <circle cx="-2" cy="1" r="1.4" fill="#f2c94c"></circle>
        </g>
        <g transform="translate(330,100)">
          <circle r="26" fill="#f2c94c"></circle>
          <ellipse cx="-3" cy="0" rx="9" ry="5.5" fill="#fff"></ellipse>
          <path d="M6,0 L15,-6 L15,6 Z" fill="#fff"></path>
          <circle cx="-8" cy="-1" r="1.4" fill="#f2c94c"></circle>
        </g>
        <g transform="translate(450,58)">
          <circle r="25" fill="#3EC8A8"></circle>
          <path d="M-11,8 L0,-9 L11,8 Z" fill="#fff"></path>
        </g>
        <g transform="translate(565,100)">
          <circle r="26" fill="#C9A2E0"></circle>
          <path d="M-6,10 L6,10 L4,3 L-4,3 Z" fill="#fff"></path>
          <rect x="-1.6" y="-6" width="3.2" height="9" rx="1.6" fill="#fff"></rect>
          <circle cx="0" cy="-8" r="5" fill="#fff"></circle>
          <circle cx="0" cy="-8" r="1.8" fill="#C9A2E0"></circle>
        </g>
        <g transform="translate(675,66)">
          <circle r="24" fill="#7fabe8"></circle>
          <path
            d="M-11,-3 Q-5.5,-8 0,-3 T11,-3"
            stroke="#fff"
            stroke-width="2.4"
            fill="none"
            stroke-linecap="round"></path>
          <path
            d="M-11,4 Q-5.5,-1 0,4 T11,4"
            stroke="#fff"
            stroke-width="2.4"
            fill="none"
            stroke-linecap="round"
            opacity=".8"></path>
        </g>
        <g transform="translate(150,178)">
          <circle r="22" fill="#ff6fa8"></circle>
          <rect
            x="-7"
            y="-3"
            width="14"
            height="11"
            rx="1.5"
            fill="none"
            stroke="#fff"
            stroke-width="2"></rect>
          <path
            d="M-7,-3 L-2,-9 L12,-9 L7,-3 Z"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linejoin="round"></path>
          <path
            d="M7,-3 L12,-9 L12,2 L7,8 Z"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linejoin="round"></path>
        </g>
        <g transform="translate(615,182)">
          <circle r="22" fill="#f2c94c"></circle>
          <line
            x1="-5"
            y1="6"
            x2="5"
            y2="-8"
            stroke="#fff"
            stroke-width="2.2"
            stroke-linecap="round"></line>
          <line
            x1="5"
            y1="6"
            x2="-5"
            y2="-8"
            stroke="#fff"
            stroke-width="2.2"
            stroke-linecap="round"></line>
          <circle cx="-5" cy="6" r="3" fill="none" stroke="#fff" stroke-width="1.8"></circle>
          <circle cx="5" cy="6" r="3" fill="none" stroke="#fff" stroke-width="1.8"></circle>
        </g>
        <g transform="translate(710,168)">
          <circle r="20" fill="#C9A2E0"></circle>
          <circle cx="0" cy="-8" r="3.5" fill="#fff"></circle>
          <rect x="-3.5" y="-4" width="7" height="8" rx="1.5" fill="#fff"></rect>
          <rect x="-8" y="-3.5" width="4.5" height="2.4" rx="1" fill="#fff"></rect>
          <rect x="3.5" y="-3.5" width="4.5" height="2.4" rx="1" fill="#fff"></rect>
          <rect x="-3" y="4" width="2.6" height="6" rx="1" fill="#fff"></rect>
          <rect x="0.4" y="4" width="2.6" height="6" rx="1" fill="#fff"></rect>
        </g>

        <!-- the four of us -->
        <g transform="translate(380,290) scale(1.3)">
          <ellipse cx="0" cy="52" rx="70" ry="8" fill="#000" opacity=".25"></ellipse>
          <circle cx="-36" cy="6" r="11" fill="#F2C9A0"></circle>
          <rect x="-46" y="15" width="20" height="30" rx="7" fill="#ff6fa8"></rect>
          <rect x="-52" y="18" width="10" height="18" rx="4" fill="#6B7FD9"></rect>
          <circle cx="-10" cy="2" r="12" fill="#F2C9A0"></circle>
          <rect x="-21" y="12" width="22" height="34" rx="7" fill="#3EC8A8"></rect>
          <rect x="-27" y="15" width="11" height="20" rx="4" fill="#2E9C82"></rect>
          <circle cx="18" cy="10" r="9" fill="#F2C9A0"></circle>
          <rect x="10" y="18" width="16" height="24" rx="6" fill="#7fabe8"></rect>
          <circle cx="42" cy="12" r="8" fill="#F2C9A0"></circle>
          <rect x="35" y="19" width="14" height="22" rx="6" fill="#8B7FD9"></rect>
        </g>
      </svg>
    </section>

    <section class="destinations">
      <h2 class="landing-h2">Guides</h2>
      <div class="cards">
        <a class="landing-card" href="/travel/houston-2026/">
          <span class="card-eyebrow">Sept 2026</span>
          <h3>Houston</h3>
          <p>Group experiences with the cousins, ranked and categorized.</p>
        </a>
        <a class="landing-card" href="/travel/iceland-2026/">
          <span class="card-eyebrow">Jul 2026</span>
          <h3>Iceland</h3>
          <p>The full 12-day trip guide — bookings, gear, what went wrong.</p>
        </a>
        <a class="landing-card" href="/travel/hawaii-2025/">
          <span class="card-eyebrow">Jun 2025</span>
          <h3>Hawaii</h3>
          <p>
            Ten days across Oʻahu and the Big Island — bookings, safety, what we'd do differently.
          </p>
        </a>
        <a class="landing-card" href="/travel/nyc-2025/">
          <span class="card-eyebrow">Several trips</span>
          <h3>NYC</h3>
          <p>Everywhere we've stayed, eaten, and taken the kids — plus how the subway works.</p>
        </a>
        <a class="landing-card" href="/travel/dallas-2025/">
          <span class="card-eyebrow">Apr 2025</span>
          <h3>Dallas</h3>
          <p>Placeholder — write-up coming soon.</p>
        </a>
        <a class="landing-card" href="/travel/japan-2024/">
          <span class="card-eyebrow">Jul 2024</span>
          <h3>Japan</h3>
          <p>One month, five base camps, eight cities — the full itinerary.</p>
        </a>
      </div>
    </section>

    <section class="destinations">
      <h2 class="landing-h2">School</h2>
      <div class="cards">
        <a class="landing-card" href="/school/blookets/">
          <span class="card-eyebrow">Study Sets</span>
          <h3>Blookets</h3>
          <p>Every Blooket set, grouped by grade and subject.</p>
        </a>
      </div>
    </section>

    <section class="also-into">
      <h2 class="landing-h2">Also into</h2>
      <div class="chip-row">
        <span class="chip">Fishing</span>
        <span class="chip">Outdoors</span>
        <span class="chip">Arcades &amp; claw machines</span>
        <span class="chip">Aquatics</span>
        <span class="chip">3D printing</span>
        <span class="chip">Crafts</span>
      </div>
      <p class="also-note">
        No guides for these yet — write-ups land here as we get around to them.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .landing-hero {
    padding: calc(var(--sp) * 1.8) 0 var(--sp);
  }
  .landing-h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(42px, 9vw, 72px);
    line-height: 0.94;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .standfirst {
    color: var(--muted);
    max-width: 48ch;
    margin: 0 0 26px;
    font-size: 16px;
  }
  .stamps {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .stamp {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 2px dashed var(--stamp);
    color: var(--stamp);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.4;
    transform: rotate(-6deg);
    flex: 0 0 auto;
    text-decoration: none;
  }
  .stamp:nth-child(even) {
    transform: rotate(4deg);
  }
  .stamp:hover {
    border-style: solid;
    color: var(--text);
    background: var(--surface2);
  }
  .illustration {
    margin: calc(var(--sp) * 1.6) 0;
    border: 1px solid var(--rule);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
  }
  .illustration svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .destinations {
    padding-bottom: calc(var(--sp) * 2);
    border-bottom: none;
  }
  .landing-h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: 26px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 0 0 16px;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 560px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .landing-card {
    display: block;
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 20px;
    background: var(--surface);
    transition: 0.15s;
    text-decoration: none;
  }
  .landing-card:hover {
    border-color: var(--gold);
    color: inherit;
  }
  .card-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 8px;
  }
  .landing-card h3 {
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .landing-card p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .also-into {
    padding-bottom: calc(var(--sp) * 2.4);
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 8px 16px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .also-note {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
</style>
