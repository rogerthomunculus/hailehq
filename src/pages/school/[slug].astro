---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import DownloadList from '../../components/ui/DownloadList.astro';
import FileBrowser from '../../components/ui/FileBrowser.astro';

export async function getStaticPaths() {
  const entries = await getCollection('school', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, downloads, filesPrefix } = entry.data;
---

<ContentLayout title={`${title} — hailehq.com`} description={summary}>
  <section class="guide-section">
    <div class="wrap">
      <div class="sec-head">
        <h2>{title}</h2>
        <p class="sec-sub">{summary}</p>
      </div>
      <div class="measure">
        <Content />
      </div>
      {downloads && downloads.length > 0 && <DownloadList downloads={downloads} />}
      {filesPrefix && <FileBrowser prefix={filesPrefix} />}
    </div>
  </section>
</ContentLayout>
