---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

const resources = (await getCollection('school', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<ContentLayout title="School — hailehq.com" description="Study packs and resources.">
  <section>
    <div class="wrap">
      <div class="sec-head">
        <h2>School</h2>
      </div>
      {
        resources.length === 0 ? (
          <p class="measure">Nothing here yet.</p>
        ) : (
          <ul class="places">
            {resources.map((r) => (
              <li>
                <b>
                  <a href={`/school/${r.id}/`}>{r.data.title}</a>
                </b>
                <span class="where">
                  Grade {r.data.grade} · {r.data.subject}
                </span>
                <span class="what">{r.data.summary}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</ContentLayout>
