---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { loadWeeks } from '../../lib/spelling';

const resources = (await getCollection('school', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const blooketGrades = await getCollection('blookets');
const blooketCount = blooketGrades.reduce(
  (total, g) => total + g.data.subjects.reduce((n, s) => n + s.sets.length, 0),
  0,
);
const spellingWeeks = await loadWeeks();
---

<ContentLayout title="School — hailehq.com" description="Study packs and resources.">
  <section class="guide-section">
    <div class="wrap">
      <div class="sec-head">
        <h2>School</h2>
      </div>
      <ul class="places">
        <li>
          <b>
            <a href="/school/blookets/">Blookets</a>
          </b>
          <span class="where">Study Sets</span>
          <span class="what">{blooketCount} Blooket sets, grouped by grade and subject.</span>
        </li>
        <li>
          <b>
            <a href="/school/study-guides/">Study Guides</a>
          </b>
          <span class="where">Study Guides</span>
          <span class="what">
            PDF guides generated to help with specific homework and topics, organized by grade.
          </span>
        </li>
        <li>
          <b>
            <a href="/school/spelling/">Spelling Practice</a>
          </b>
          <span class="where">Grade 2 · APAAS</span>
          <span class="what">
            {spellingWeeks.length} weekly word list{spellingWeeks.length === 1 ? '' : 's'}, read
            aloud and checked, with a running note of the words that still need work.
          </span>
        </li>
        {
          resources.map((r) => (
            <li>
              <b>
                <a href={`/school/${r.id}/`}>{r.data.title}</a>
              </b>
              <span class="where">
                Grade {r.data.grade} · {r.data.subject}
              </span>
              <span class="what">{r.data.summary}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</ContentLayout>
