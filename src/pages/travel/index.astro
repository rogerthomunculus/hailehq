---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

const guides = (await getCollection('travel', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<ContentLayout title="Travel — hailehq.com" description="Family trip guides.">
  <section class="guide-section">
    <div class="wrap">
      <div class="sec-head">
        <h2>Travel</h2>
      </div>
      <ul class="places">
        {
          guides.map((g) => (
            <li>
              <b>
                <a href={`/travel/${g.id}/`}>{g.data.title}</a>
              </b>
              <span class="where">
                {g.data.destination} · {g.data.year}
              </span>
              <span class="what">{g.data.summary}</span>
            </li>
          ))
        }
        <li>
          <b>
            <a href="/travel/houston-2026/">Houston with the cousins</a>
          </b>
          <span class="where">Houston · Sept 2026</span>
          <span class="what">
            Ranked group experiences and food for Labor Day weekend — a filterable venue list, not a
            day-by-day narrative.
          </span>
        </li>
      </ul>
    </div>
  </section>
</ContentLayout>
