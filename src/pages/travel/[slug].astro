---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import TravelHero from '../../components/travel/TravelHero.astro';
import JumpNav from '../../components/travel/JumpNav.astro';
import PrintButton from '../../components/ui/PrintButton.astro';

export async function getStaticPaths() {
  // Guides with their own dedicated page + layout (a distinct design system,
  // not the shared Section/Note/Day components) are excluded here so this
  // dynamic route doesn't also try to generate — and conflict with — them.
  const selfHostedSlugs = new Set(['japan-2024']);
  const entries = await getCollection(
    'travel',
    ({ data, id }) => !data.draft && !selfHostedSlugs.has(id),
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, travellers, year, bases, sections, dateLabel } = entry.data;

const dateRange =
  dateLabel ??
  `${entry.data.startDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}–${entry.data.endDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}, ${year}`;
---

<ContentLayout title={`${title} — hailehq.com`} description={summary}>
  <TravelHero
    eyebrow={`${dateRange} · ${travellers}`}
    title={entry.data.destination}
    titleAccent="with kids"
    lede={summary}
    bases={bases}
  />
  <div class="wrap" style="padding: 1.2rem 0 0;">
    <PrintButton />
  </div>
  {sections && <JumpNav links={sections.map((s) => ({ href: `#${s.id}`, label: s.label }))} />}
  <Content />
</ContentLayout>
